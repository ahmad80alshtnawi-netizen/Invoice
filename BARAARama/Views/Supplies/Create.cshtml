@model BARAARama.ViewModels.CreateSupplyViewModel

@{
    ViewData["Title"] = "New Supply";
}

<style>
    .supplier-page {
        max-width: 1100px;
        margin: 40px auto;
    }

    .supplier-card {
        background: #ffffff;
        border: 1px solid #e3eaf5;
        border-radius: 18px;
        padding: 32px;
        box-shadow: 0 8px 28px rgba(31, 78, 121, 0.08);
    }

    .supplier-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        margin-bottom: 28px;
    }

    .supplier-title {
        color: #1e3a5f;
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 4px;
    }

    .supplier-subtitle {
        color: #6b7c93;
        margin: 0;
    }

    .supplier-badge {
        background: #e8f1ff;
        color: #2463a9;
        border-radius: 999px;
        padding: 9px 18px;
        font-weight: 600;
        white-space: nowrap;
    }

    .section-title {
        color: #244b76;
        font-size: 1rem;
        font-weight: 700;
        margin-bottom: 16px;
    }

    .supplier-section {
        background: #f8fbff;
        border: 1px solid #e5edf7;
        border-radius: 14px;
        padding: 22px;
        margin-bottom: 22px;
    }

    .supplier-label {
        color: #34495e;
        font-weight: 600;
        margin-bottom: 7px;
    }

    .supplier-input {
        border: 1px solid #d6e1ef;
        border-radius: 10px;
        min-height: 46px;
    }

    .supplier-input:focus {
        border-color: #4f8edc;
        box-shadow: 0 0 0 0.2rem rgba(79, 142, 220, 0.12);
    }

    .supplier-input[readonly] {
        background: #f2f6fb;
    }

    .supplier-btn {
        background: #2f74c0;
        color: white;
        border: none;
        border-radius: 10px;
        padding: 11px 24px;
        font-weight: 600;
    }

    .supplier-btn:hover {
        background: #245f9f;
        color: white;
    }

    .history-btn {
        border: 1px solid #b9cee8;
        color: #2f6da9;
        border-radius: 10px;
        padding: 10px 22px;
        text-decoration: none;
        font-weight: 600;
    }

    .history-btn:hover {
        background: #f0f6fd;
        color: #245f9f;
    }

    .supplier-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 8px;
    }

    .field-hint {
        color: #8291a5;
        font-size: 0.83rem;
        margin-top: 5px;
    }
</style>


<div class="supplier-page">

    <div class="supplier-card">

        <div class="supplier-header">

            <div>
                <h1 class="supplier-title">
                    Supplier Entry
                </h1>

                <p class="supplier-subtitle">
                    Record incoming material and update inventory.
                </p>
            </div>

            <span class="supplier-badge">
                Supplier
            </span>

        </div>


        <form asp-action="Create"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger">
            </div>


            <!-- Supplier Information -->
            <div class="supplier-section">

                <div class="section-title">
                    Supplier Information
                </div>

                <div class="row g-3">

                    <div class="col-md-6">

                        <label asp-for="SupplierNumber"
                               class="supplier-label">
                        </label>

                        <input asp-for="SupplierNumber"
                               class="form-control supplier-input"
                               id="supplierNumber" />

                        <span asp-validation-for="SupplierNumber"
                              class="text-danger">
                        </span>

                        <div class="field-hint">
                            Existing supplier numbers will automatically load the supplier name.
                        </div>

                    </div>


                    <div class="col-md-6">

                        <label asp-for="SupplierName"
                               class="supplier-label">
                        </label>

                        <input asp-for="SupplierName"
                               class="form-control supplier-input"
                               id="supplierName" />

                        <span asp-validation-for="SupplierName"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-6">

                        <label asp-for="Date"
                               class="supplier-label">
                        </label>

                        <input asp-for="Date"
                               type="datetime-local"
                               class="form-control supplier-input"
                               readonly />

                    </div>

                </div>

            </div>


            <!-- Material Information -->
            <div class="supplier-section">

                <div class="section-title">
                    Material Information
                </div>

                <div class="row g-3">

                    <div class="col-md-6">

                        <label asp-for="ProductNumber"
                               class="supplier-label">
                        </label>

                        <input asp-for="ProductNumber"
                               class="form-control supplier-input"
                               id="productNumber" />

                        <span asp-validation-for="ProductNumber"
                              class="text-danger">
                        </span>

                        <div class="field-hint">
                            Existing product numbers will automatically load the product name.
                        </div>

                    </div>


                    <div class="col-md-6">

                        <label asp-for="ProductName"
                               class="supplier-label">
                        </label>

                        <input asp-for="ProductName"
                               class="form-control supplier-input"
                               id="productName" />

                        <span asp-validation-for="ProductName"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-6">

                        <label asp-for="Quantity"
                               class="supplier-label">
                        </label>

                        <input asp-for="Quantity"
                               class="form-control supplier-input"
                               min="1" />

                        <span asp-validation-for="Quantity"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-6">

                        <label asp-for="Price"
                               class="supplier-label">
                        </label>

                        <input asp-for="Price"
                               class="form-control supplier-input"
                               min="0.01"
                               step="0.01" />

                        <span asp-validation-for="Price"
                              class="text-danger">
                        </span>

                    </div>

                </div>

            </div>


            <div class="supplier-actions">

                <a asp-action="Index"
                       class="history-btn">
                    Supply History
                </a>

                <button type="submit"
                        class="supplier-btn">
                    Save Supply
                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        const supplierNumber =
            document.getElementById("supplierNumber");

        const supplierName =
            document.getElementById("supplierName");


        supplierNumber.addEventListener(
            "blur",
            async function () {

                const number =
                    supplierNumber.value.trim();

                if (!number) {
                    return;
                }

                const response =
                    await fetch(
                        '@Url.Action("GetSupplier", "Supplies")'
                        + '?supplierNumber='
                        + encodeURIComponent(number));

                const data =
                    await response.json();

                if (data.found) {
                    supplierName.value = data.name;
                    supplierName.readOnly = true;
                }
                else {
                    supplierName.readOnly = false;
                }
            });


        supplierNumber.addEventListener(
            "input",
            function () {

                supplierName.readOnly = false;
            });


        const productNumber =
            document.getElementById("productNumber");

        const productName =
            document.getElementById("productName");


        productNumber.addEventListener(
            "blur",
            async function () {

                const number =
                    productNumber.value.trim();

                if (!number) {
                    return;
                }

                const response =
                    await fetch(
                        '@Url.Action("GetProduct", "Supplies")'
                        + '?productNumber='
                        + encodeURIComponent(number));

                const data =
                    await response.json();

                if (data.found) {
                    productName.value = data.name;
                    productName.readOnly = true;
                }
                else {
                    productName.readOnly = false;
                }
            });


        productNumber.addEventListener(
            "input",
            function () {

                productName.readOnly = false;
            });

    </script>
}